# Copia este archivo como .env en el servidor. Nunca subas .env al repositorio.

PORT=3000
APP_ORIGIN=http://localhost:5173

# Google Veo (Vertex AI): requiere proyecto Google Cloud, facturación/permisos,
# autenticación de servidor (Application Default Credentials) y bucket GCS.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_OUTPUT_GCS_URI=gs://TU_BUCKET/evolution-ai/
VEO_MODEL=veo-3.1-fast-generate-001
# Configura ADC con una cuenta de servicio en el hosting; no pongas claves en el frontend.

# Wan (Alibaba Cloud Model Studio): URL y clave de la misma región.
WAN_API_URL=
WAN_API_KEY=
WAN_MODEL=wan2.7-t2v
WAN_RESOLUTION=720P
# Opcional: URL base de consulta de tareas si el proveedor usa otra ruta.
WAN_TASK_STATUS_URL=

# LTX API
LTX_API_KEY=
LTX_MODEL=ltx-2-5-fast
