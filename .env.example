# Evolution AI — variables privadas del servidor. No subas un archivo .env al repositorio.

PORT=3000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# ÚNICA CLAVE necesaria para activar la generación multimotor.
# Créala en el panel de fal.ai y guárdala como secreto en tu hosting.
FAL_KEY=

# Límite de motores por solicitud. Máximo permitido por esta app: 5.
# Por control de costes, empieza con 1; puedes cambiarlo a 3 o 5.
FAL_MAX_MODELS=1

# Modelos disponibles (elige hasta FAL_MAX_MODELS):
# fal-ai/veo3.1/fast
# fal-ai/kling-video/v3/standard/text-to-video
# fal-ai/wan/v2.7/text-to-video
# bytedance/seedance-2.0/fast/text-to-video
# fal-ai/ltx-2.3-22b/text-to-video
# minimax/h3-max-turbo/text-to-video
FAL_MODELS=minimax/h3-max-turbo/text-to-video

# Límite para evitar gasto accidental. Máximo de solicitudes por IP y hora.
GENERATION_LIMIT_PER_HOUR=2
